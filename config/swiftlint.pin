# The one SwiftLint every check uses: CI installs exactly this release (scripts/swiftlint-pin.sh --install)
# and the gate fails when the swiftlint on PATH is another version (scripts/swiftlint-pin.sh --check).
# sha256 is that of the release asset portable_swiftlint.zip of the tag. Change both together, by hand:
# curl -sSL -o p.zip https://github.com/realm/SwiftLint/releases/download/<version>/portable_swiftlint.zip; shasum -a 256 p.zip
version=0.65.1
sha256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
