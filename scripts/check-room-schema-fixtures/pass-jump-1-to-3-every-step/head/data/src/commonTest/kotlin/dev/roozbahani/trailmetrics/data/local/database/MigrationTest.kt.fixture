package dev.roozbahani.trailmetrics.data.local.database

import kotlin.test.Test
import kotlin.test.assertEquals

class MigrationTest {
    @Test
    fun migrates_1_2KeepsRows() {
        val migration = MIGRATION_1_2
        assertEquals(2, migration.endVersion)
    }

    @Test
    fun migrates_2_3KeepsRows() {
        val migration = MIGRATION_2_3
        assertEquals(3, migration.endVersion)
    }
}
